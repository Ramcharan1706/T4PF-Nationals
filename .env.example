# Backend / Render secrets (never expose these to the frontend)
ENVIRONMENT=production
DATABASE_BACKEND=supabase
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,https://t4-pf-nationals.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret

# Frontend / Vercel public configuration
VITE_API_URL=https://t4pf-nationals.onrender.com
